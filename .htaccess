<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # ==========================================================
    # 1. Trainees Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/trainees/$ api/v1/trainees/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/trainees/$ api/v1/trainees/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/trainees/update$ api/v1/trainees/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/trainees/$ api/v1/trainees/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/trainees/search$ api/v1/trainees/search.php [L]


    # ==========================================================
    # 2. Trainers Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/trainers/$ api/v1/trainers/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/trainers/$ api/v1/trainers/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/trainers/update$ api/v1/trainers/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/trainers/$ api/v1/trainers/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/trainers/search$ api/v1/trainers/search.php [L]


    # ==========================================================
    # 3. Auth/Profile Routes (ملاحظة: تم تعديل مسار الطلب ليطابق النمط)
    # ==========================================================
    RewriteRule ^api/v1/auth/register$ api/v1/auth/register.php [L]
    RewriteRule ^api/v1/auth/login$ api/v1/auth/login.php [L]
    RewriteRule ^api/v1/auth/profile$ api/v1/auth/profile.php [L]
    RewriteRule ^api/v1/auth/logout$ api/v1/auth/logout.php [L]
    RewriteRule ^api/v1/auth/reset-password$ api/v1/auth/reset_password.php [L]
    RewriteRule ^api/v1/auth/verify-token$ api/v1/auth/verify_token.php [L]


    # ==========================================================
    # 4. Equipment Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/equipment/$ api/v1/equipment/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/equipment/$ api/v1/equipment/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/equipment/update$ api/v1/equipment/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/equipment/$ api/v1/equipment/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/equipment/search$ api/v1/equipment/search.php [L]


    # ==========================================================
    # 5. News Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/news/$ api/v1/news/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/news/$ api/v1/news/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/news/update$ api/v1/news/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/news/$ api/v1/news/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/news/search$ api/v1/news/search.php [L]


    # ==========================================================
    # 6. Subscription Plans Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/subscription_plans/$ api/v1/subscription_plans/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/subscription_plans/$ api/v1/subscription_plans/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/subscription_plans/update$ api/v1/subscription_plans/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/subscription_plans/$ api/v1/subscription_plans/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/subscription_plans/search$ api/v1/subscription_plans/search.php [L]


    # ==========================================================
    # 7. Branches Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/branches/$ api/v1/branches/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/branches/$ api/v1/branches/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/branches/update$ api/v1/branches/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/branches/$ api/v1/branches/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/branches/search$ api/v1/branches/search.php [L]


    # ==========================================================
    # 8. Training Programs Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/training_programs/$ api/v1/training_programs/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/training_programs/$ api/v1/training_programs/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/training_programs/update$ api/v1/training_programs/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/training_programs/$ api/v1/training_programs/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/training_programs/search$ api/v1/training_programs/search.php [L]


    # ==========================================================
    # 9. News Categories Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/news_categories/$ api/v1/news_categories/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/news_categories/$ api/v1/news_categories/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/news_categories/update$ api/v1/news_categories/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/news_categories/$ api/v1/news_categories/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/news_categories/search$ api/v1/news_categories/search.php [L]


    # ==========================================================
    # 10. Plan Features Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/plan_features/$ api/v1/plan_features/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/plan_features/$ api/v1/plan_features/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/plan_features/update$ api/v1/plan_features/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/plan_features/$ api/v1/plan_features/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/plan_features/search$ api/v1/plan_features/search.php [L]


    # ==========================================================
    # 11. Bookings Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/bookings/$ api/v1/bookings/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/bookings/$ api/v1/bookings/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/bookings/update$ api/v1/bookings/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/bookings/$ api/v1/bookings/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/bookings/search$ api/v1/bookings/search.php [L]


    # ==========================================================
    # 12. Trainee Programs Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/trainee_programs/$ api/v1/trainee_programs/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/trainee_programs/$ api/v1/trainee_programs/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/trainee_programs/update$ api/v1/trainee_programs/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/trainee_programs/$ api/v1/trainee_programs/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/trainee_programs/search$ api/v1/trainee_programs/search.php [L]


    # ==========================================================
    # 13. Diet Plans Clean Routes (ملفات مخصصة)
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/diets/$ api/v1/programs/index_diet.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/diets/$ api/v1/programs/create_diet.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/diets/update$ api/v1/programs/update_diet.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/diets/$ api/v1/programs/delete_diet.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/diets/search$ api/v1/programs/search_diet.php [L]


    # ==========================================================
    # 14. Reviews Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/reviews/$ api/v1/reviews/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/reviews/$ api/v1/reviews/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/reviews/update$ api/v1/reviews/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/reviews/$ api/v1/reviews/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/reviews/search$ api/v1/reviews/search.php [L]


    # ==========================================================
    # 15. Messages Clean Routes
    # ==========================================================
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/messages/$ api/v1/messages/index.php [L]

    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^api/v1/messages/$ api/v1/messages/create.php [L]

    RewriteCond %{REQUEST_METHOD} PUT
    RewriteRule ^api/v1/messages/update$ api/v1/messages/update.php [L]

    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/v1/messages/$ api/v1/messages/delete.php [L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^api/v1/messages/search$ api/v1/messages/search.php [L]

</IfModule>